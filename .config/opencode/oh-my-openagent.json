      "fallback_models": ["openai/gpt-5.6-sol", "openai/gpt-5.5"]
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.6-sol",
      "fallback_models": ["openai/gpt-5.5", ""]
    },
    "OpenCode-Builder": {
      "model": "openai/gpt-5.6-sol-pro",
      "fallback_models": ["openai/gpt-5.6-sol", "openai/gpt-5.5", ""]
