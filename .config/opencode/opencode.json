{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["opencode"],
  "plugin": [
    "opencode-openai-codex-auth@4.4.0",
    "oh-my-openagent",
    "@slkiser/opencode-quota@3.11.2",
    "/Users/rauffaizov/.bun/install/global/node_modules/@rynfar/meridian/dist/meridian"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:~/.local/share/opencode/secrets/context7-api-key}"
      },
      "enabled": true
    },
    "clockify": {
      "type": "remote",
      "url": "https://api.clockify.me/mcp-server/mcp",
      "oauth": false,
      "headers": {
        "x-api-key": "{file:~/.local/share/opencode/secrets/clockify-api-key}"
      },
      "enabled": true
    }
  },
  "model": "anthropic/claude-fable-5",
  "agent": {
    "build": {
      "prompt": "You are a helpful AI assistant. Provide detailed explanations of your reasoning and actions. Explain what you're doing and why. Include context about the changes you make. Be conversational and thorough in your responses rather than overly concise."
    },
    "plan": {
      "prompt": "You are a helpful AI assistant. Provide detailed explanations of your reasoning and planning. Explain your approach and why you're taking certain steps. Be conversational and thorough in your responses rather than overly concise."
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "formatter": {
    "stylua": {
      "command": ["stylua", "$FILE"],
      "extensions": [".lua"]
    }
  },
  "lsp": {
    "lua-language-server": {
      "command": ["lua-language-server"],
      "extensions": [".lua"]
    },
    "gopls": {
      "command": ["gopls"],
      "extensions": [".go", ".mod", ".sum"]
    },
    "rust-analyzer": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"]
    },
    "vtsls": {
      "command": ["vtsls", "--stdio"],
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".mts", ".cts"]
    }
  }
}
