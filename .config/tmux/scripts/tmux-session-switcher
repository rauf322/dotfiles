#!/usr/bin/env bash

set -euo pipefail

for command in tmux fzf-tmux; do
    command -v "$command" >/dev/null 2>&1 || {
        printf 'Required command not found: %s\n' "$command" >&2
        exit 1
    }
done

tmux_option_or_fallback() {
    local option_value
    option_value=$(tmux show-option -gqv "$1")
    printf '%s' "${option_value:-$2}"
}

worktree_switcher_popup() {
    local border_label="$1"
    local preview_command="$2"
    shift 2

    local width height layout preview_location preview_ratio prompt pointer additional_options
    local -a theme_options=()

    width=$(tmux_option_or_fallback '@worktree-switcher-window-width' '85%')
    height=$(tmux_option_or_fallback '@worktree-switcher-window-height' '85%')
    layout=$(tmux_option_or_fallback '@worktree-switcher-layout' 'reverse')
    preview_location=$(tmux_option_or_fallback '@worktree-switcher-preview-location' 'right')
    preview_ratio=$(tmux_option_or_fallback '@worktree-switcher-preview-ratio' '50%')
    prompt=$(tmux_option_or_fallback '@worktree-switcher-prompt' ' ')
    pointer=$(tmux_option_or_fallback '@worktree-switcher-pointer' '▶')
    additional_options=$(tmux show-option -gqv '@worktree-switcher-additional-options')
    [[ -n "$additional_options" ]] && eval "theme_options=($additional_options)"

    fzf-tmux -p "$width,$height" \
        --layout="$layout" \
        --prompt="$prompt" \
        --pointer="$pointer" \
        --preview="$preview_command" \
        --preview-window="$preview_location,$preview_ratio,," \
        --border-label="$border_label" \
        --bind='?:toggle-preview' \
        --bind='ctrl-u:preview-half-page-up' \
        --bind='ctrl-d:preview-half-page-down' \
        --bind='focus:transform-preview-label:echo [ {1} ]' \
        --scrollbar='▌▐' \
        --exit-0 \
        "${theme_options[@]}" \
        "$@"
}

# Extract project from a workmux session name: "revo-biz__master" -> "revo-biz"
session_project() {
    local session="$1"
    printf '%s' "${session%%__*}"
}

# Extract branch from a workmux session name: "revo-biz__master" -> "master"
session_branch() {
    local session="$1"
    printf '%s' "${session#*__}"
}

# Check if a session name is a workmux worktree session (contains __)
is_worktree_session() {
    [[ "$1" == *"__"* ]]
}

worktree_session_records() {
    local wanted_project="$1"
    local session project

    while IFS= read -r session; do
        is_worktree_session "$session" || continue
        project=$(session_project "$session")
        [[ "$project" == "$wanted_project" ]] || continue
        printf '%s\t%s\n' "$(session_branch "$session")" "$session"
    done < <(tmux list-sessions -F '#{session_name}')
}

prioritize_last_target() {
    local preferred="$1"
    awk -F $'\t' -v preferred="$preferred" '
        !seen[$0]++ {
            if (!found && $3 == preferred) {
                first = $0
                found = 1
            } else {
                records[++count] = $0
            }
        }
        END {
            if (found) print first
            for (i = 1; i <= count; i++) print records[i]
        }
    '
}

declare -A seen_projects=()
menu=""
current_session=$(tmux display-message -p '#S')
last_session=$(tmux display-message -p '#{client_last_session}' 2>/dev/null || true)
last_target="$last_session"

if [[ -n "$last_session" ]] && is_worktree_session "$last_session"; then
    last_target=$(session_project "$last_session")
fi

while IFS= read -r session; do
    if is_worktree_session "$session"; then
        project=$(session_project "$session")
        [[ -n "$project" ]] || continue
        if [[ -z "${seen_projects[$project]:-}" ]]; then
            menu+="${project} [worktrees]"$'\t'"worktree-project"$'\t'"${project}"$'\n'
            seen_projects[$project]=1
        fi
    elif [[ "$session" != "$current_session" ]]; then
        menu+="${session}"$'\t'"session"$'\t'"${session}"$'\n'
    fi
done < <(tmux list-sessions -F '#{session_name}')

if [[ -z "$menu" ]]; then
    printf 'No other sessions.\n' >&2
    exit 0
fi
preview_script="$HOME/.config/tmux/scripts/tmux-session-preview"
selection=$(printf '%s' "$menu" | prioritize_last_target "$last_target" | worktree_switcher_popup "Current session: $current_session" "$preview_script {2} {3}" --delimiter=$'\t' --with-nth=1) || exit 0
selection_type=$(printf '%s' "$selection" | cut -f2)

if [[ "$selection_type" == "worktree-project" ]]; then
    project=$(printf '%s' "$selection" | cut -f3)

    repo_root=""
    while IFS=$'\t' read -r _branch sess; do
        wt_path=$(tmux display-message -t "=$sess:" -p '#{pane_current_path}' 2>/dev/null) || continue
        common_dir=$(git -C "$wt_path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || continue
        repo_root=$(dirname "$common_dir")
        break
    done < <(worktree_session_records "$project")

    if [[ -n "$repo_root" && -d "$repo_root/.git" ]]; then
        tmux display-popup -B -w 100% -h 100% -E "cd '$repo_root' && workmux dashboard -t worktrees"
    else
        # Repo root not resolvable (panes cd'd elsewhere) — fall back to the
        # project's first worktree session instead of silently doing nothing.
        fallback_session=$(worktree_session_records "$project" | head -n1 | cut -f2)
        [[ -n "$fallback_session" ]] && tmux switch-client -t "=$fallback_session"
    fi
    exit 0
else
    target_session=$(printf '%s' "$selection" | cut -f3)
fi

[[ -n "$target_session" ]] && tmux switch-client -t "=$target_session"
