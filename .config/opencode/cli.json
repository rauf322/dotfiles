{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-frappe",
    "mode": "dark"
  },
  "plugins": [
    "@slkiser/opencode-quota@3.11.2",
    "oh-my-openagent"
  ],
  "diffs": {
    "wrap": "word"
  },
  "terminal": {
    "title": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
