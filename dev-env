#!/usr/bin/env bash

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

dry="0"
choice=""

while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--dry" ]]; then
        dry="1"
    elif [[ "$1" == "--copy:root:config" ]]; then
        choice="copy:root:config"
    elif [[ "$1" == "--copy:dir:config" ]]; then
        choice="copy:dir:config"
    elif [[ "$1" == "--info" ]]; then
        choice="info"
    elif [[ "$1" == "--copy:root:local" ]]; then
        choice="copy:root:local"
    elif [[ "$1" == "--copy:dir:local" ]]; then
        choice="copy:dir:local"
    fi
    shift
done

log() {
    if [[ $dry == "1" ]]; then
        echo "[DRY_RUN]: $@"
    else
        echo "$@"
    fi
}

execute() {
    log "execute $@"
    if [[ $dry == "1" ]]; then
        return
    fi
    "$@"
}

log "--------------- dev-env ---------------"

# Top-level entries that are app state, caches, binaries, or secrets — never synced
skip_dirs=(
    ".git" ".omo" ".codegraph" ".android" ".foundry"
    "swiftpm" "nvm" "fish" "yabai" "skhd"
    "openchamber" "configstore" "github-copilot"
    "ngrok" "expressvpn" "com.strapi" "btop"
    "raycast" "raycast-x"
    "bin" "pipx"
)

# Agent artifacts, caches, and secrets excluded at any depth
excludes=(
    --exclude=".git"
    --exclude=".omo"
    --exclude=".codegraph"
    --exclude=".DS_Store"
    --exclude="node_modules"
    --exclude="*.key"
    --exclude="*.lock"
    --exclude="automatic_backups"
    --exclude="chats"
    --exclude="antigravity-accounts.json"
    --exclude="prompts-library-db.0.mdb"
)

should_skip() {
    local name=$1
    for s in "${skip_dirs[@]}"; do
        if [[ "$name" == "$s" ]]; then
            return 0
        fi
    done
    return 1
}

sync_dirs() {
    from=$1
    to=$2

    for dir in $(find "$from" -mindepth 1 -maxdepth 1 -type d -not -path "*/share" -not -path "*/state" -not -path "*/cache"); do
        name=$(basename "$dir")
        if should_skip "$name"; then
            log "skip $name"
            continue
        fi
        execute mkdir -p "$to/$name"
        execute rsync -a --delete "${excludes[@]}" "$dir/" "$to/$name/"
    done
}

copy_file() {
    from=$1
    to=$2
    name=$(basename "$from")
    echo "$to/$name"

    execute rm -f "$to/$name"
    execute cp "$from" "$to/$name"
}

copy_file "$HOME/.zshrc" "$script_dir/.config"

if [[ $choice == "copy:root:config" ]]; then
    log "Syncing $XDG_CONFIG_HOME -> $script_dir/.config"
    sync_dirs "$XDG_CONFIG_HOME" "$script_dir/.config"
elif [[ $choice == "copy:dir:config" ]]; then
    log "Syncing $script_dir/.config -> $XDG_CONFIG_HOME"
    sync_dirs "$script_dir/.config" "$XDG_CONFIG_HOME"
elif [[ $choice == "copy:dir:local" ]]; then
    log "Syncing $script_dir/.local -> $HOME/.local"
    sync_dirs "$script_dir/.local" "$HOME/.local"
elif [[ $choice == "copy:root:local" ]]; then
    log "Syncing $HOME/.local -> $script_dir/.local"
    sync_dirs "$HOME/.local" "$script_dir/.local"
elif [[ $choice == "info" ]]; then
    log "You have multiple options:"
    log "--dry run"
    log "--copy:root:config copy from XDG_CONFIG_HOME to dev-env"
    log "--copy:dir:config copy from dev-env to XDG_CONFIG_HOME"
    log "--copy:root:local copy from \$HOME/.local to dev-env"
    log "--copy:dir:local copy from dev-env to \$HOME/.local"
    log "--info show this message"
fi
