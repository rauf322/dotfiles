#!/usr/bin/env bash

set -euo pipefail

mode="${1:-}"
target="${2:-}"

session_environment() {
    local session="$1"
    local variable="$2"
    local value

    value=$(tmux show-environment -t "=$session" "$variable" 2>/dev/null || true)
    if [[ "$value" == "$variable="* ]]; then
        printf '%s' "${value#*=}"
    fi
}

if [[ "$mode" == "session" ]]; then
    exec tmux capture-pane -ep -t "=$target:"
fi

if [[ "$mode" == "worktree-project" ]]; then
    printf '\033[1;36m%s\033[0m\n\n' "$target"
    while IFS= read -r session; do
        [[ $(session_environment "$session" TMUX_WORKTREE) == "1" ]] || continue
        [[ $(session_environment "$session" TMUX_WORKTREE_PROJECT) == "$target" ]] || continue
        branch=$(session_environment "$session" TMUX_WORKTREE_BRANCH)
        command=$(tmux list-panes -t "=$session" -F '#{?pane_active,#{pane_current_command},}' | awk 'NF { print; exit }')
        printf '\033[1;33m%s\033[0m  \033[2m%s\033[0m\n' "$branch" "$command"
        tmux list-windows -t "=$session" -F '  #{?window_active,▶, } #{window_index}: #{window_name}'
        printf '\n'
    done < <(tmux list-sessions -F '#{session_name}')
fi
