// Mirrors ~/.config/nvim keymaps (leader = space). Bindings without a Zed equivalent are omitted.
[
  {
    "context": "!Terminal && Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      "shift-k": "editor::Hover",
      "shift-u": "vim::Redo",
      "shift-h": "tab_switcher::ToggleAll",
      "-": "pane::RevealInProjectPanel",
      "g r": "editor::FindAllReferences",
      "g shift-d": "editor::GoToDefinition",
      "ctrl-space": "editor::SelectLargerSyntaxNode",
      "ctrl-n": ["agent::ToggleFocus", { "agent": { "custom": { "name": "OpenCode" } } }],
      "space shift-p": ["agent::ToggleFocus", { "agent": { "custom": { "name": "OpenCode" } } }],
      "space space": "command_palette::Toggle",
      "space y": ["workspace::SendKeystrokes", "\" + y"],
      "space n o": "editor::Cancel",
      "space s": "editor::Format",
      "space c a": "editor::ToggleCodeActions",
      "space r n": "editor::Rename",
      "space d": "editor::Hover",
      "space shift-d": "diagnostics::Deploy",
      "space t t": "diagnostics::Deploy",
      "space t d": "editor::GoToTypeDefinition",
      "space o": "outline::Toggle",
      "space ?": "zed::OpenKeymap",
      "space `": "terminal_panel::Toggle",
      "space tab": "file_finder::Toggle",
      "space p s": "pane::DeploySearch",
      "space e f": "project_panel::ToggleFocus",
      "space f f": "pane::RevealInProjectPanel",
      "space b d": "pane::CloseActiveItem",
      "space b a": "pane::CloseAllItems",
      "space b o": "pane::CloseOtherItems",
      "space a a": "pane::TogglePinTab",
      "space a m": "tab_switcher::Toggle",
      "space a n": "pane::ActivateNextItem",
      "space a p": "pane::ActivatePreviousItem",
      "space 1": ["pane::ActivateItem", 0],
      "space 2": ["pane::ActivateItem", 1],
      "space 3": ["pane::ActivateItem", 2],
      "space 4": ["pane::ActivateItem", 3],
      "space g g": "git::Diff",
      "space g s": "git_panel::ToggleFocus",
      "space g shift-h": "git_panel::ActivateHistoryTab",
      "space g t": "branches::OpenRecent",
      "space g p": "editor::ToggleSelectedDiffHunks",
      "space g l": ["task::Spawn", { "task_name": "lazygit" }],
      "space s h": "git::StageAndNext",
      "space u h": "git::UnstageAndNext",
      "space c m": "git::Commit",
      "space |": "pane::SplitVertical",
      "space -": "pane::SplitHorizontal",
      "space shift-f": "workspace::ToggleZoom",
      "space w =": "vim::ResetPaneSizes",
      "space h": "workspace::ActivatePaneLeft",
      "space j": "workspace::ActivatePaneDown",
      "space k": "workspace::ActivatePaneUp",
      "space l": "workspace::ActivatePaneRight",
      "space w shift-h": "workspace::MovePaneLeft",
      "space w shift-j": "workspace::MovePaneDown",
      "space w shift-k": "workspace::MovePaneUp",
      "space w shift-l": "workspace::MovePaneRight",
      "space w h": "vim::ResizePaneRight",
      "space w l": "vim::ResizePaneLeft",
      "space w j": "vim::ResizePaneUp",
      "space w k": "vim::ResizePaneDown",
      "shift-down": ["workspace::SendKeystrokes", "5 ctrl-e"],
      "shift-up": ["workspace::SendKeystrokes", "5 ctrl-y"]
    }
  },
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !menu",
    "bindings": {
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp",
      "space d": ["workspace::SendKeystrokes", "\" _ d"],
      "space o a": "agent::AddSelectionToThread",
      "ctrl-backspace": "editor::SelectSmallerSyntaxNode"
    }
  },
  {
    "context": "Editor && vim_mode == insert && !VimWaiting && !menu",
    "bindings": {
      "j j": "vim::NormalBefore",
      "k k": "vim::NormalBefore",
      "h h": "vim::NormalBefore"
    }
  },
  {
    "context": "!Terminal && !Editor && vim_mode != insert",
    "bindings": {
      "space space": "command_palette::Toggle",
      "space tab": "file_finder::Toggle",
      "space p s": "pane::DeploySearch",
      "space `": "terminal_panel::Toggle",
      "space g s": "git_panel::ToggleFocus",
      "space e f": "workspace::ToggleRightDock",
      "space h": "workspace::ActivatePaneLeft",
      "space j": "workspace::ActivatePaneDown",
      "space k": "workspace::ActivatePaneUp",
      "space l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "ProjectPanel && !editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "r": "project_panel::Rename",
      "shift-d": "project_panel::Delete",
      "-": "project_panel::SelectParent",
      "space f f": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "GitPanel",
    "bindings": {
      "space g s": "workspace::ToggleRightDock",
      "x": "git::ToggleStaged",
      "shift-x": "git::StageAll",
      "shift-u": "git::UnstageAll",
      "i": "git_panel::FocusEditor",
      "j": "git_panel::NextEntry",
      "k": "git_panel::PreviousEntry",
      "space l": "workspace::ActivatePaneRight",
      "enter": ["action::Sequence", ["project_panel::Open", "workspace::ToggleLeftDock"]]
    }
  },
  {
    "context": "",
    "bindings": {
      "alt-tab": "tab_switcher::Toggle"
    }
  }
]
