#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

dry="0"
if [[ "${1:-}" == "--dry" ]]; then
    dry="1"
fi

log() {
    if [[ $dry == "1" ]]; then
        echo "[DRY_RUN]: $*"
    else
        echo "$*"
    fi
}

execute() {
    log "execute $*"
    if [[ $dry == "1" ]]; then
        return
    fi
    "$@"
}

log "--------------- bootstrap ---------------"

# Homebrew itself
if ! command -v brew >/dev/null 2>&1; then
    execute /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Everything brew-managed: taps, formulae, casks, fonts, vscode extensions
execute brew bundle --file="$script_dir/Brewfile"

# bun (not brew-managed) + opencode
if ! command -v bun >/dev/null 2>&1 && [[ ! -x "$HOME/.bun/bin/bun" ]]; then
    execute /bin/bash -c "$(curl -fsSL https://bun.sh/install)"
fi
if [[ ! -x "$HOME/.bun/bin/opencode" ]]; then
    execute "$HOME/.bun/bin/bun" install -g opencode-ai
fi

log "Done. Deploy configs with: ./dev-env --copy:dir:config && ./dev-env --copy:dir:local"
